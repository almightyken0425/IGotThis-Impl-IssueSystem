# IGotThis 環境變數範本。複製為 .env 後填入實際值，.env 不進版控。

# ── 伺服器 ──────────────────────────────────────────────
# 單體伺服器監聽埠，同時承 API 與 web 建置產物的靜態託管
PORT=8768
HOST=127.0.0.1
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────────────────
# docker-compose.yml 的 db 服務預設值，與此處保持一致
POSTGRES_USER=igotthis
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=igotthis
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 應用實際使用的連線字串
DATABASE_URL=postgres://igotthis:change_me_local_only@127.0.0.1:5432/igotthis

# ── 認證 ───────────────────────────────────────────────
# session cookie 簽章密鑰，正式環境必須改成隨機長字串
# 產生方式：node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_random_48_bytes_base64url
SESSION_COOKIE_NAME=igotthis_sid
# session 存活秒數，預設 14 天
SESSION_TTL_SECONDS=1209600
