{
  "name": "igotthis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IGotThis issue system monorepo root",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @igotthis/server",
    "dev:web": "npm run dev --workspace @igotthis/web",
    "build": "npm run build --workspace @igotthis/web && npm run build --workspace @igotthis/server",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
