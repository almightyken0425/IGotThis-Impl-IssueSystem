{
  "name": "@igotthis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IGotThis 單體伺服器：API、認證、資料存取與 domain 純邏輯",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:test": "tsx src/db/migrate.ts --test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.6.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
